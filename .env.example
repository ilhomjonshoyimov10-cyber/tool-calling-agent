# Any OpenAI-compatible provider with function calling. Examples:
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.8-flash
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=<tool-capable model id>
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1                                LLM_MODEL=<model id>
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

MAX_STEPS=6
HISTORY_MESSAGES=10
TASKS_DB_PATH=data/tasks.db
